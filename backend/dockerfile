# Dockerfile
FROM python:3.11-slim

# System dependencies for raw psycopg2 PostgreSQL drivers
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY . .

ENV PORT=8000
EXPOSE 8000

# Start Gunicorn server directly (No Nginx needed)

# Run with Gunicorn production server using 4 parallel workers
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:8000", "run:app"]